<Window x:Class="VECLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEC Launcher"
        Icon="pack://application:,,,/logo.ico"
        Height="700" Width="1140"
        MinHeight="500" MinWidth="800"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        Foreground="{DynamicResource Fg}"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="WindowBorder" Background="{DynamicResource BgDeep}" CornerRadius="0"
            BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
            SizeChanged="WindowBorder_SizeChanged">
        <Grid>
            <Rectangle x:Name="WindowBgLayer" Fill="Transparent" IsHitTestVisible="False"/>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0A0A0C" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/logo.ico" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VEC" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text=" PLATFORM" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Fg}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Background="Transparent"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButton}" Content="🌐 vec.kpvk.edu.kz" Command="{Binding OpenWebsiteCommand}" Margin="0,0,8,0" ToolTip="Открыть официальный сайт VEC" Height="28" Padding="10,0"/>
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" Click="BtnMinimize_Click" ToolTip="Свернуть">
                        <Path Data="M 0,6 L 10,6" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Click="BtnMaximize_Click" ToolTip="Развернуть">
                        <Path x:Name="MaximizeIcon" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Click="BtnClose_Click" ToolTip="Закрыть">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="215"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">

                    <Grid x:Name="PageHome" Grid.Row="0">
                        <Border>
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/home_bg.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <Border VerticalAlignment="Bottom" Height="340" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#40000000" Offset="0.35"/>
                                    <GradientStop Color="#B0000000" Offset="0.7"/>
                                    <GradientStop Color="#E0000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border x:Name="ProgressArea" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,24" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" Width="320"
                                Background="#35161A28" BorderBrush="#38FFFFFF" BorderThickness="1"
                                CornerRadius="0" Padding="14,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.18" Color="White"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtProgressStage" Text="{Binding ProgressStage}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#E0E0EC" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtProgressPercent" Grid.Column="1" Text="{Binding ProgressPercent}" FontSize="11.5" FontWeight="Black"
                                               Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="PbProgress" Grid.Row="1" Height="5" Minimum="0" Maximum="100" Value="0"/>
                            </Grid>
                        </Border>

                        <Grid HorizontalAlignment="Right" Width="340" Margin="0,0,60,0">
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,30,50" HorizontalAlignment="Right">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <Border x:Name="ServerInfoBadge" VerticalAlignment="Center" Margin="0,0,14,0"
                                            Background="#1408090D" BorderBrush="#25FFFFFF" BorderThickness="1"
                                            CornerRadius="0" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center"/>
                                            <TextBlock Text=" " FontSize="5"/>
                                            <TextBlock x:Name="TxtServerPlayers" Text="— / —" FontSize="12.5" FontWeight="Bold"
                                                       Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="BtnConnectVEC" Height="48" MinWidth="165"
                                            Click="BtnConnectVEC_Click" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            MouseEnter="BtnConnectVEC_MouseEnter"
                                            MouseLeave="BtnConnectVEC_MouseLeave">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnHomeBd" Background="#F59E0B" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="0">
                                                    <Border.Effect>
                                                        <DropShadowEffect x:Name="BtnHomeShadow" Color="#F59E0B" BlurRadius="16"
                                                                         ShadowDepth="0" Opacity="0.3"/>
                                                    </Border.Effect>
                                                    <TextBlock x:Name="BtnHomeText" Text="ИГРАТЬ" FontSize="18" FontWeight="Bold"
                                                               FontFamily="{StaticResource FontMinecraft}"
                                                               Foreground="#08090D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnHomeBd" Property="Background" Value="#FBBF24"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="BtnHomeBd" Property="Background" Value="#D97706"/>
                                                        <Setter TargetName="BtnHomeBd" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform Y="1"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <Border Height="1" Background="White" Opacity="0.22"
                                        Margin="14,16,14,0" CornerRadius="0"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="НАИГРАНО:  " FontSize="9" FontWeight="Bold"
                                               Foreground="White" Opacity="0.5"/>
                                    <TextBlock x:Name="StatTotalTime" Text="0 ч" FontSize="9"
                                               FontWeight="Bold" Foreground="White" Opacity="0.85"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="PageAccount" Grid.Row="0" Margin="0" Visibility="Collapsed">
                        <Grid.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/account_bg.jpg" Stretch="UniformToFill" Opacity="0.12"/>
                        </Grid.Background>
                        <Grid Margin="24,14,24,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ПРОФИЛЬ И ГАРДЕРОБ" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Единый аккаунт VEC ID, лицензия Minecraft, персонализация скина и гардероб плащей"
                                           Foreground="#888" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,20">
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#111319" BorderBrush="#232730" BorderThickness="2" CornerRadius="0" Padding="14">
                                        <StackPanel>
                                            <Border Background="#0D0E13" BorderBrush="#1F232D" BorderThickness="1" CornerRadius="0" Height="380" Width="288">
                                                <Grid x:Name="SkinViewerHost"
                                                      MouseDown="SkinViewport_MouseDown" MouseMove="SkinViewport_MouseMove"
                                                      MouseUp="SkinViewport_MouseUp" MouseWheel="SkinViewport_MouseWheel"
                                                      Cursor="SizeAll">
                                                    <Viewport3D x:Name="SkinViewport3D" Visibility="Visible">
                                                        <Viewport3D.Camera>
                                                            <PerspectiveCamera x:Name="SkinCamera" Position="0, 0, 48" LookDirection="0, 0, -1" UpDirection="0, 1, 0" FieldOfView="45"/>
                                                        </Viewport3D.Camera>
                                                        <ModelVisual3D>
                                                            <ModelVisual3D.Content>
                                                                <Model3DGroup>
                                                                    <AmbientLight Color="#DDDDDD"/>
                                                                    <DirectionalLight Color="#666666" Direction="-1, -2, -3"/>
                                                                    <DirectionalLight Color="#444444" Direction="1, 1, 2"/>
                                                                </Model3DGroup>
                                                            </ModelVisual3D.Content>
                                                        </ModelVisual3D>
                                                        <ModelVisual3D x:Name="SkinModelVisual"/>
                                                    </Viewport3D>

                                                    <Grid x:Name="SkinViewerPlaceholder" Visibility="Visible" IsHitTestVisible="False">
                                                        <Grid.Background>
                                                            <ImageBrush ImageSource="pack://application:,,,/Assets/account_bg.jpg" Stretch="UniformToFill" Opacity="0.08"/>
                                                        </Grid.Background>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="Войдите, чтобы увидеть скин" FontSize="13" Foreground="#666"
                                                                       TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                        <Button x:Name="BtnRefreshSkin" Width="30" Height="30" Margin="0,0,6,0"
                                                                Background="#141720" Foreground="White" BorderBrush="#3C4250" BorderThickness="1"
                                                                Cursor="Hand" ToolTip="Синхронизировать скин и плащ с сервером VEC"
                                                                Click="BtnRefreshSkin_Click">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="0"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="↻" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>

                                                        <Button x:Name="BtnResetSkin" Width="30" Height="30"
                                                                Background="#141720" Foreground="#AAA" BorderBrush="#3C4250" BorderThickness="1"
                                                                Cursor="Hand" ToolTip="Сбросить скин на стандартный"
                                                                Click="BtnResetSkin_Click">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="0"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="↺" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <StackPanel Margin="0,14,0,0">
                                                <Border Background="#0D0F14" BorderBrush="#1F232D" BorderThickness="1" CornerRadius="0" Padding="10,6" Margin="0,0,0,8">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="РУКИ" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                                            <TextBlock x:Name="TxtToggleModelBadge" Text="Classic" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <CheckBox x:Name="ToggleModelSwitch" HorizontalAlignment="Right"
                                                                  Style="{StaticResource MinecraftSwitchStyle}"
                                                                  Click="ToggleModelSwitch_Click" ToolTip="Переключить модель Classic (4px) / Slim (3px)"/>
                                                    </Grid>
                                                </Border>

                                                <Button x:Name="BtnBrowseSkin" Height="36" Background="#23252D" BorderBrush="#374151" BorderThickness="1"
                                                        Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnBrowseSkin_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="0"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="Загрузить скин (.png)" VerticalAlignment="Center"/>
                                                </Button>
                                                <TextBlock x:Name="TxtSelectedSkinFileName" FontSize="11" Foreground="#34D399" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSkinStatus" Text="" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="#888" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <Border x:Name="BorderProfileCard" Background="#161922" BorderBrush="#232730" BorderThickness="2"
                                                CornerRadius="0" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <TextBlock Text="ОСНОВНАЯ ИНФОРМАЦИЯ" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Grid>
                                                <Border Height="1" Background="#232730" Margin="0,0,0,16"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="0" Background="#111319" BorderBrush="#232730" BorderThickness="1" ClipToBounds="True">
                                                        <Image x:Name="ImgAvatarLarge" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock x:Name="TxtAccName" Text="Игрок" FontWeight="Bold" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock x:Name="TxtLicenseBadge" Text="Mojang" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="TxtMinecraftNick" Text="Minecraft: —" Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <Button x:Name="BtnLogout" Grid.Column="2" Content="Выйти"
                                                            Background="Transparent" Foreground="#EF4444" BorderBrush="#3A2222" BorderThickness="1"
                                                            Padding="16,6" FontSize="11.5" Cursor="Hand" Click="BtnLogout_Click" IsEnabled="True" VerticalAlignment="Center">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="0"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="BorderLoginCard" Background="#161922" BorderBrush="#232730" BorderThickness="2"
                                                CornerRadius="0" Padding="24,22" Margin="0,0,0,16" Visibility="Visible">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <TextBlock Text="АВТОРИЗАЦИЯ" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Grid>
                                                <Border Height="1" Background="#232730" Margin="0,0,0,16"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                                        <TextBlock Text="ЕДИНЫЙ ВХОД VEC ID" FontSize="11.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                                        <TextBlock Text="Авторизуйтесь через единый аккаунт платформы VEC" FontWeight="Bold" FontSize="14.5" Foreground="#FFFFFF" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                        <TextBlock Text="Авторизация через веб-браузер. Лицензия Mojang, скины и гардероб плащей синхронизируются автоматически."
                                                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                                    </StackPanel>

                                                    <Button x:Name="BtnVecLogin" Grid.Column="1" Style="{StaticResource AccentButton}"
                                                            Content="Войти через VEC ID" Padding="24,12" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                            Click="BtnVecLogin_Click">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="0"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-22,0,0" Background="#191B22" BorderBrush="#22C55E" BorderThickness="2" CornerRadius="0" Padding="12,3" Panel.ZIndex="2">
                                        <TextBlock Text="ВЫБЕРИТЕ СВОЙ ПЛАЩ" FontSize="11" FontWeight="Bold" Foreground="#22C55E"/>
                                    </Border>

                                    <Border Background="#191B22" BorderBrush="#232730" BorderThickness="2" CornerRadius="0" Padding="24,20,24,20">
                                        <StackPanel>
                                            <Border Height="2" Background="#22C55E" Margin="-24,-20,-24,18"/>
                                            <TextBlock Text="ПРИОБРЕТЕННЫЕ ПЛАЩИ" FontSize="12" FontWeight="ExtraBold" Foreground="#E5E7EB" Margin="0,0,0,6"/>
                                            <TextBlock Text="Плащи — это особые награды, которые игроки могут разблокировать во время событий, кампаний и прочих веселых приключений."
                                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>

                                            <WrapPanel x:Name="CapesWrapPanel" Margin="0,0,0,16"/>

                                            <Border Height="1" Background="#232730" Margin="0,6,0,18"/>

                                            <TextBlock Text="АКТИВАЦИЯ ПРОМОКОДА НА ПЛАЩ" FontSize="12" FontWeight="ExtraBold" Foreground="#E5E7EB" Margin="0,0,0,6"/>
                                            <TextBlock Text="Введите полученный промокод для разблокировки и надевания плаща."
                                                       Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,12"/>

                                            <Grid MaxWidth="500" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtCapePromoCode" Grid.Column="0" Height="36" Width="280"
                                                         Background="#111319" Foreground="White" BorderBrush="#2B303C" BorderThickness="1"
                                                         Padding="12,0" VerticalContentAlignment="Center" FontFamily="Consolas, monospace"
                                                         FontSize="13" TextWrapping="NoWrap" Margin="0,0,10,0"
                                                         KeyDown="TxtCapePromoCode_KeyDown">
                                                    <TextBox.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="0"/>
                                                        </Style>
                                                    </TextBox.Resources>
                                                </TextBox>
                                                <Button x:Name="BtnRedeemCapePromo" Grid.Column="1" Height="36" Content="Активировать"
                                                        Background="#23252D" Foreground="White" BorderBrush="#374151" BorderThickness="1"
                                                        Padding="20,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="BtnRedeemCapePromo_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="0"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="TxtCapePromoStatus" FontSize="11.5" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Grid>


                    <Grid x:Name="PageSettings" Grid.Row="0" Margin="24,14,18,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,6,0">
                            <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource H1}"/>
                            <TextBlock Text="Параметры запуска, выделение памяти и хранилище"
                                       Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton x:Name="SecGame" Style="{StaticResource SegmentToggle}" Content="Игра"
                                         IsChecked="True" Checked="SettingsSection_Checked" Tag="game"/>
                            <RadioButton x:Name="SecJava" Style="{StaticResource SegmentToggle}" Content="Java и память"
                                         Checked="SettingsSection_Checked" Tag="java"/>
                            <RadioButton x:Name="SecStorage" Style="{StaticResource SegmentToggle}" Content="Хранилище и очистка"
                                         Checked="SettingsSection_Checked" Tag="storage"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,0,6,10">
                                <StackPanel x:Name="SecPanelGame">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ОКНО ИГРЫ" Style="{StaticResource Caption}"/>
                                            <Grid Margin="0,4,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Ширина (px)" FontSize="11" Foreground="#777788" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="TxtWidth" Width="110" Text="1280" LostFocus="Setting_Changed" TextChanged="SettingText_Changed"/>
                                                </StackPanel>

