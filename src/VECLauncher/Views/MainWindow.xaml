                                                                                <Border.Background>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                        <GradientStop Color="#1A212F" Offset="0"/>
                                                                                        <GradientStop Color="#0F131C" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <Border>
                                                                                <Border.Background>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                        <GradientStop Color="#20000000" Offset="0"/>
                                                                                        <GradientStop Color="#60000000" Offset="0.5"/>
                                                                                        <GradientStop Color="#E610131B" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </Border.Background>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>

                                                                    <Grid Grid.Row="1" Margin="16,-34,16,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="62"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="62" Height="62" CornerRadius="0"
                                                                                Background="#0E1118" BorderBrush="#252F42" BorderThickness="1"
                                                                                ClipToBounds="True" VerticalAlignment="Top">
                                                                            <Grid>
                                                                                <Image Source="{Binding IconImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                                <Border Visibility="{Binding DefaultIconVisibility}">
                                                                                    <TextBlock Text="{Binding IconLetter}" FontFamily="{StaticResource FontMinecraftTitle}"
                                                                                               FontSize="24" Foreground="#64748B"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" Margin="14,34,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontMinecraft}"
                                                                                       FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11.5" Foreground="#94A3B8"
                                                                               Margin="16,16,16,14" TextWrapping="Wrap" MaxHeight="54" LineHeight="19" TextTrimming="CharacterEllipsis"/>

                                                                    <WrapPanel Grid.Row="3" Margin="16,0,16,14">
                                                                        <Border Background="#141824" BorderBrush="#232C3E" BorderThickness="1" CornerRadius="0"
                                                                                Padding="8,3" Margin="0,0,6,4">
                                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                                                        </Border>
                                                                        <Border Background="#141824" BorderBrush="#232C3E" BorderThickness="1" CornerRadius="0"
                                                                                Padding="8,3" Margin="0,0,6,4">
                                                                            <TextBlock Text="{Binding VersionTag}" FontSize="10" Foreground="#64748B"/>
                                                                        </Border>
                                                                        <Border Background="#141824" BorderBrush="#232C3E" BorderThickness="1" CornerRadius="0"
                                                                                Padding="8,3" Margin="0,0,6,4">
                                                                            <TextBlock Text="{Binding SizeTag}" FontSize="10" Foreground="#64748B"/>
                                                                        </Border>
                                                                    </WrapPanel>

                                                                    <Border Grid.Row="4" Background="#0C0E14" BorderBrush="#1C2333" BorderThickness="0,1,0,0" Padding="16,12">
                                                                        <TextBlock Text="Серверный компонент" FontFamily="{StaticResource FontMinecraft}"
                                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel x:Name="SecOptional" Margin="0,0,0,18">
                                                <TextBlock Text="ОПЦИОНАЛЬНЫЕ" FontFamily="{StaticResource FontMinecraft}" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,12"/>
                                                <ItemsControl x:Name="ItemsOptional">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#10131B" CornerRadius="0" HorizontalAlignment="Stretch" MinHeight="310" Margin="0,0,16,16"
                                                                    BorderBrush="#1E2536" BorderThickness="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#10131B"/>
                                                                        <Setter Property="BorderBrush" Value="#1E2536"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#141822"/>
                                                                                <Setter Property="BorderBrush" Value="#2F3950"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="118"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <Border Grid.Row="0" Height="118" BorderBrush="#1C2333" BorderThickness="0,0,0,1" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image Source="{Binding BannerImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            <Border Visibility="{Binding DefaultBannerVisibility}">
                                                                                <Border.Background>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                        <GradientStop Color="#1A212F" Offset="0"/>
                                                                                        <GradientStop Color="#0F131C" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <Border>
                                                                                <Border.Background>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                        <GradientStop Color="#20000000" Offset="0"/>
                                                                                        <GradientStop Color="#60000000" Offset="0.5"/>
                                                                                        <GradientStop Color="#E610131B" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </Border.Background>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>

                                                                    <Grid Grid.Row="1" Margin="16,-34,16,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="62"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="62" Height="62" CornerRadius="0"
                                                                                Background="#0E1118" BorderBrush="#252F42" BorderThickness="1"
                                                                                ClipToBounds="True" VerticalAlignment="Top">
                                                                            <Grid>
                                                                                <Image Source="{Binding IconImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                                <Border Visibility="{Binding DefaultIconVisibility}">
                                                                                    <TextBlock Text="{Binding IconLetter}" FontFamily="{StaticResource FontMinecraftTitle}"
                                                                                               FontSize="24" Foreground="#64748B"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" Margin="14,34,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontMinecraft}"
                                                                                       FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11.5" Foreground="#94A3B8"
                                                                               Margin="16,16,16,14" TextWrapping="Wrap" MaxHeight="54" LineHeight="19" TextTrimming="CharacterEllipsis"/>

                                                                    <WrapPanel Grid.Row="3" Margin="16,0,16,14">
                                                                        <Border Background="#141824" BorderBrush="#232C3E" BorderThickness="1" CornerRadius="0"
                                                                                Padding="8,3" Margin="0,0,6,4">
                                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                                                        </Border>
                                                                        <Border Background="#141824" BorderBrush="#232C3E" BorderThickness="1" CornerRadius="0"
                                                                                Padding="8,3" Margin="0,0,6,4">
                                                                            <TextBlock Text="{Binding VersionTag}" FontSize="10" Foreground="#64748B"/>
                                                                        </Border>
                                                                        <Border Background="#141824" BorderBrush="#232C3E" BorderThickness="1" CornerRadius="0"
                                                                                Padding="8,3" Margin="0,0,6,4">
                                                                            <TextBlock Text="{Binding SizeTag}" FontSize="10" Foreground="#64748B"/>
                                                                        </Border>
                                                                    </WrapPanel>

                                                                    <Border Grid.Row="4" Background="#0C0E14" BorderBrush="#1C2333" BorderThickness="0,1,0,0" Padding="16,12">
                                                                        <Button HorizontalAlignment="Stretch" Padding="0,9" Cursor="Hand" Click="ContentToggle_Click" Tag="{Binding Path}">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="BtnBd" Background="#161B26" BorderBrush="#2D3548" BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                                                                        <TextBlock Text="{Binding ToggleText}" FontFamily="{StaticResource FontMinecraft}" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="BtnBd" Property="Background" Value="#222A3B"/>
                                                                                            <Setter TargetName="BtnBd" Property="BorderBrush" Value="#4B5875"/>
                                                                                            <Setter TargetName="BtnBd" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border x:Name="DropHint" Visibility="Collapsed" CornerRadius="0"
                                            Background="#EE0B0B0E" BorderThickness="1" BorderBrush="#2D3548">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Перетащите файлы сюда" FontFamily="{StaticResource FontMinecraft}" FontSize="13" FontWeight="Bold"
                                                       Margin="0,8,0,0" Foreground="#FFFFFF"/>
                                            <TextBlock x:Name="TxtDropTarget" Text="" FontSize="11" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center" Foreground="#777788"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="#0C0C0E" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="14,14,14,8">
                            <TextBlock Text="МЕНЮ" FontSize="9.5" FontWeight="Bold" Foreground="#444455"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,10">
                                <RadioButton x:Name="NavHome" Style="{StaticResource NavToggleDiscord}" IsChecked="True" Checked="Nav_Checked" Tag="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/main_page.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Главная" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavContent" Style="{StaticResource NavToggleDiscord}" Checked="Nav_Checked" Tag="7">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/content_page.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Контент сборки" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavAccount" Style="{StaticResource NavToggleDiscord}" Checked="Nav_Checked" Tag="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/profile_page.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Профиль" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavSettings" Style="{StaticResource NavToggleDiscord}" Checked="Nav_Checked" Tag="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/setting_page.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="BorderSideUser" Grid.Row="2" Background="#0A0A0E" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="BorderSideUser_Click" ToolTip="Нажмите для переключения профиля">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#121218"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="0" Background="#14141A" BorderThickness="0" ClipToBounds="True">
                                    <Image x:Name="ImgAvatar" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSideName" Text="{Binding SideName}" FontWeight="SemiBold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="5" Height="5" Fill="#777788" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSideStatus" Text="{Binding SideStatus}" FontSize="10" Foreground="#777788" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="⋮" FontSize="15" Foreground="#555566" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PopupSavedAccounts" PlacementTarget="{Binding ElementName=BorderSideUser}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                            <Border Width="220" Background="#0C0C10" BorderBrush="#1C1C24" BorderThickness="1" CornerRadius="0" Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.7" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="ПРОФИЛИ" FontSize="9" FontWeight="Bold" Foreground="#444455" Margin="6,3,6,6"/>

                                    <StackPanel x:Name="StackSidebarAccounts"/>

                                    <Border Height="1" Background="#16161E" Margin="2,4,2,4"/>

                                    <Button x:Name="BtnSidebarAddAccount" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="BtnSidebarAddAccount_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="0" Padding="6,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#AAAAAA" Width="18" TextAlignment="Center"/>
                                                        <TextBlock Text="Добавить аккаунт..." FontSize="11" Foreground="#CCCCCC" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#15151D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="BtnSidebarLogout" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="BtnSidebarLogout_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="0" Padding="6,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#777788" Width="18" TextAlignment="Center"/>
                                                        <TextBlock Text="Выйти из аккаунта" FontSize="11" Foreground="#777788" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#181414"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Border>
</Window>
