<Window x:Class="VECLauncher.Installer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEC Launcher • Установщик"
        Width="520" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0D0D0D"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Flat VEC Titlebar -->
            <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    MouseDown="OnTitleBarMouseDown">
                <Grid Margin="12,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/logo.ico" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="VEC Launcher" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text=" • Установщик" Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Content="—" Click="OnMinimizeClick"/>
                        <Button Style="{StaticResource TitleBarCloseButton}" Content="✕" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="24,20">

                <!-- 1. WELCOME STEP -->
                <Grid Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                        <Image Source="pack://application:,,,/logo.ico" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="VEC Launcher" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Официальный игровой лаунчер VEC" FontSize="12.5" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Content="Установить" Width="220" Command="{Binding StartInstallCommand}"/>
                        <Button Content="{Binding IsOptionsExpanded, ConverterParameter='Параметры установки', FallbackValue='Параметры установки ▾'}"
                                Command="{Binding ToggleOptionsCommand}"
                                Foreground="{DynamicResource FgMuted}" FontSize="12" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2" Visibility="{Binding IsOptionsExpanded, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="0" Padding="12,10" Margin="0,10,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Папка установки:" Foreground="{DynamicResource FgMuted}" FontSize="11.5" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FlatTextBox}" IsReadOnly="True" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource BaseButton}"
                                        Height="34" Padding="10,0" Command="{Binding BrowsePathCommand}"/>
                            </Grid>

                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="Ярлык на рабочем столе" IsChecked="{Binding CreateDesktopShortcut}"
                                          Style="{StaticResource FlatCheckBox}" Margin="0,0,16,4"/>
                                <CheckBox Content="Ярлык в меню «Пуск»" IsChecked="{Binding CreateStartMenuShortcut}"
                                          Style="{StaticResource FlatCheckBox}" Margin="0,0,16,4"/>
                                <CheckBox Content="Запустить лаунчер" IsChecked="{Binding LaunchAfterInstall}"
                                          Style="{StaticResource FlatCheckBox}" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. INSTALLING / PROGRESS STEP -->
                <Grid Visibility="{Binding IsInstallingStep, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="Установка VEC Launcher" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Загрузка и подготовка файлов..." FontSize="12.5" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="0" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Fg}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SpeedDisplay}" Foreground="{DynamicResource FgMuted}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <ProgressBar Style="{StaticResource FlatProgressBar}" Value="{Binding ProgressPercent}" Maximum="100"/>

                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}" Foreground="{DynamicResource FgMuted}" FontSize="11.5" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource BaseButton}" Content="Отмена" Command="{Binding CancelCommand}"
                                Width="100" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 3. COMPLETED STEP -->
                <Grid Visibility="{Binding IsCompletedStep, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Установка завершена" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                        <TextBlock Text="VEC Launcher готов к запуску." FontSize="13" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center" Margin="0,6,0,24"/>

                        <Button Style="{StaticResource AccentButton}" Content="Запустить VEC Launcher" Width="220" Command="{Binding LaunchAppCommand}"/>
                        <Button Style="{StaticResource BaseButton}" Content="Закрыть" Width="100" Command="{Binding CancelCommand}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 4. ERROR STEP -->
                <Grid Visibility="{Binding IsErrorStep, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="Ошибка при установке" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Не удалось завершить операцию:" FontSize="12.5" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center" Margin="0,4,0,14"/>

                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,18" MaxHeight="80">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ErrorDetails}" TextWrapping="Wrap" Foreground="#DDDDDD" FontSize="12" FontFamily="Consolas, Segoe UI"/>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource AccentButton}" Content="Попробовать снова" Width="180" Command="{Binding StartInstallCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource BaseButton}" Content="Закрыть" Width="100" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 5. UNINSTALL STEP -->
                <Grid Visibility="{Binding IsUninstallStep, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Удаление VEC Launcher" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Вы действительно хотите удалить лаунчер и связанные ярлыки?" FontSize="12.5" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource DangerButton}" Content="Удалить лаунчер" Width="160" Command="{Binding StartUninstallCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource BaseButton}" Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
