                                            <Button Style="{StaticResource DangerButton}"
                                                    Content="Полная переустановка (стереть все данные лаунчера)"
                                                    HorizontalContentAlignment="Left" Margin="0,0,0,8"
                                                    Click="BtnReinstallFull_Click"/>
                                            <Button Style="{StaticResource DangerButton}"
                                                    Content="Полностью удалить лаунчер с компьютера"
                                                    HorizontalContentAlignment="Left"
                                                    Click="BtnUninstall_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                    </Grid>

                    <Grid x:Name="PageContent" Grid.Row="0" Margin="0" Visibility="Collapsed"
                          AllowDrop="True" Drop="Content_Drop" DragOver="Content_DragOver">
