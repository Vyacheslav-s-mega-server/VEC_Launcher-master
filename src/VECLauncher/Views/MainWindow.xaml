                                                        Padding="12,5" Click="MemAuto_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="УСТАНОВЛЕННЫЕ JAVA" Style="{StaticResource Caption}"/>
                                                <Button Style="{StaticResource IconButton}" Content="Искать заново"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-6,0,0" Click="BtnRescanJava_Click"/>
                                            </Grid>
                                            
                                            <TextBlock x:Name="TxtJavaStatus" Text="Поиск установленных версий Java…"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       Margin="0,4,0,4"/>

                                            <ItemsControl x:Name="ItemsJava" Margin="0,6,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" Foreground="#FFFFFF"
                                                                           FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource FgMuted}"
                                                                           FontSize="10.5" Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                                    Content="Выбрать" VerticalAlignment="Center"
                                                                    Padding="12,5" FontSize="11" Margin="12,0,0,0"
                                                                    Tag="{Binding Path}" Click="BtnSelectJava_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Свой путь к java.exe (пусто = автоматический выбор лаунчером)"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       Margin="0,12,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtJavaPath" Grid.Column="0" LostFocus="Setting_Changed" TextChanged="SettingText_Changed"/>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        Content="Обзор" Margin="8,0,0,0" Click="BtnBrowseJava_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Content="Сброс" Margin="8,0,0,0" Click="BtnClearJava_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="АРГУМЕНТЫ JVM" Style="{StaticResource Caption}"/>
                                            <TextBox x:Name="TxtJvmArgs" LostFocus="Setting_Changed" TextChanged="SettingText_Changed" Margin="0,4,0,0"/>
                                            <TextBlock Text="Дополнительные флаги запуска виртуальной машины. Пример: -XX:+UseZGC"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="SecPanelStorage" Visibility="Collapsed">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ПАПКА ЛАУНЧЕРА" Style="{StaticResource Caption}"/>
                                            <Grid Margin="0,4,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtGameDir" Grid.Column="0" IsReadOnly="True"/>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        Content="Открыть папку" Margin="8,0,0,0" Click="BtnOpenDir_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="АНАЛИЗ И ОЧИСТКА МЕСТА" Style="{StaticResource Caption}"/>
                                                <Button Style="{StaticResource IconButton}" Content="Пересчитать"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-4,0,0" Click="BtnScanMaint_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtMaintTotal" Text="Нажмите «Пересчитать»"
                                                       Foreground="#777788" FontSize="11.5"
                                                       Margin="0,2,0,12"/>

                                            <ItemsControl x:Name="ItemsMaint">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#101218" CornerRadius="0"
                                                                Padding="12,10" Margin="0,0,0,6" BorderThickness="1"
                                                                BorderBrush="{Binding RowBorder}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" IsChecked="{Binding Checked, Mode=OneTime}"
                                                                          VerticalAlignment="Center" Tag="{Binding Key}"
                                                                          Checked="MaintItem_Changed"
                                                                          Unchecked="MaintItem_Changed"/>

                                                                <StackPanel Grid.Column="1" Margin="12,0,12,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{Binding TitleColor}"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                                               Foreground="#777788"
                                                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#FFFFFF"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Style="{StaticResource IconButton}" Content="Выбрать безопасное"
                                                        Margin="0,0,8,0" Click="BtnMaintSafe_Click"/>
                                                <Button Style="{StaticResource DangerButton}" Content="Удалить выбранное"
                                                        Margin="0,0,8,0" Click="BtnMaintClean_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="Очистить только кэш"
                                                        Click="BtnClearCache_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtMaintenance" Text="" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource Accent}" FontSize="11.5"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ПОЛНЫЙ СБРОС И УДАЛЕНИЕ" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="Действия ниже необратимы. Миры, моды и скриншоты будут стерты без возможности восстановления."
                                                       Foreground="#F87171" FontSize="11"
                                                       Margin="0,2,0,12" TextWrapping="Wrap"/>

                                            <Button Style="{StaticResource IconButton}"
                                                    Content="Сбросить настройки лаунчера к значениям по умолчанию"
                                                    HorizontalContentAlignment="Left" Margin="0,0,0,8"
                                                    Click="BtnResetSettings_Click"/>
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="Переустановить начисто (удалить Java и библиотеки, сохранить сборки)"
                                                    HorizontalContentAlignment="Left" Margin="0,0,0,8"
