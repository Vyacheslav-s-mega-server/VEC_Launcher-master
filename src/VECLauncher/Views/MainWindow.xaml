                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Padding="18,8" Margin="0,0,8,0" Cursor="Hand" Click="BtnOpenContentFolder_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="#12151E" BorderBrush="#262D3D" BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="Папка" FontFamily="{StaticResource FontMinecraft}" FontSize="12.5" Foreground="#E2E8F0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1C2130"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3E4860"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Padding="18,8" Cursor="Hand" Click="BtnRefreshContent_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="#12151E" BorderBrush="#262D3D" BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="Обновить" FontFamily="{StaticResource FontMinecraft}" FontSize="12.5" Foreground="#E2E8F0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1C2130"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3E4860"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

