                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Разрешить несколько копий игры" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Выключено по умолчанию для защиты от случайного повторного запуска" Foreground="{DynamicResource FgMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ChkAllowMultiple" Grid.Column="1" Style="{StaticResource MinecraftSwitchStyle}" VerticalAlignment="Center"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource BorderBrushDark}" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Подтверждать остановку игры" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Запрашивать подтверждение при нажатии кнопки принудительной остановки" Foreground="{DynamicResource FgMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ChkConfirmStop" Grid.Column="1" Style="{StaticResource MinecraftSwitchStyle}" VerticalAlignment="Center"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource BorderBrushDark}" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Показывать консоль отладки" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Отображать лог вывода Java в отдельной вкладке лаунчера" Foreground="{DynamicResource FgMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ChkShowConsole" Grid.Column="1" Style="{StaticResource MinecraftSwitchStyle}" VerticalAlignment="Center"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ЯЗЫК ИГРЫ" Style="{StaticResource Caption}"/>

                                            <Grid Margin="0,6,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Устанавливать язык автоматически" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
