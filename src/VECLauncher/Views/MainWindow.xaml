                                             IsChecked="True" Checked="ContentKind_Checked" Tag="mods"/>
                                <RadioButton x:Name="CtRp" Style="{StaticResource SegmentToggle}" Content="Ресурспаки"
                                             Checked="ContentKind_Checked" Tag="rp"/>
                                <RadioButton x:Name="CtShaders" Style="{StaticResource SegmentToggle}" Content="Шейдеры"
                                             Checked="ContentKind_Checked" Tag="shaders"/>
                            </StackPanel>

                            <Border Grid.Row="2" Background="Transparent">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
