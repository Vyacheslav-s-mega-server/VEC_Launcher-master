                                <RadioButton x:Name="NavHome" Style="{StaticResource NavToggleDiscord}" IsChecked="True" Checked="Nav_Checked" Tag="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/main_page.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Главная" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavContent" Style="{StaticResource NavToggleDiscord}" Checked="Nav_Checked" Tag="7">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/content_page.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Контент сборки" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavAccount" Style="{StaticResource NavToggleDiscord}" Checked="Nav_Checked" Tag="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/profile_page.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Профиль" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavSettings" Style="{StaticResource NavToggleDiscord}" Checked="Nav_Checked" Tag="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/setting_page.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="BorderSideUser" Grid.Row="2" Background="#0A0A0E" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="BorderSideUser_Click" ToolTip="Нажмите для переключения профиля">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#121218"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#14141A" BorderThickness="0" ClipToBounds="True">
                                    <Image x:Name="ImgAvatar" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSideName" Text="{Binding SideName}" FontWeight="SemiBold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="5" Height="5" Fill="#777788" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSideStatus" Text="{Binding SideStatus}" FontSize="10" Foreground="#777788" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="⋮" FontSize="15" Foreground="#555566" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            </Grid>
                        </Border>

                        <!-- Custom Minimalist Monochrome Profiles Popup -->
                        <Popup x:Name="PopupSavedAccounts" PlacementTarget="{Binding ElementName=BorderSideUser}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                            <Border Width="220" Background="#0C0C10" BorderBrush="#1C1C24" BorderThickness="1" CornerRadius="8" Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.7" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="ПРОФИЛИ" FontSize="9" FontWeight="Bold" Foreground="#444455" Margin="6,3,6,6"/>

                                    <StackPanel x:Name="StackSidebarAccounts"/>

                                    <Border Height="1" Background="#16161E" Margin="2,4,2,4"/>

                                    <Button x:Name="BtnSidebarAddAccount" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="BtnSidebarAddAccount_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="6,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#AAAAAA" Width="18" TextAlignment="Center"/>
                                                        <TextBlock Text="Добавить аккаунт..." FontSize="11" Foreground="#CCCCCC" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#15151D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="BtnSidebarLogout" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="BtnSidebarLogout_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="6,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#777788" Width="18" TextAlignment="Center"/>
                                                        <TextBlock Text="Выйти из аккаунта" FontSize="11" Foreground="#777788" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#181414"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Border>
</Window>
